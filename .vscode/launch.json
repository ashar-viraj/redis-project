{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug redis server",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/redis",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build-debug"
        },
        {
            "name": "Attach to redis server",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/redis",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
